+// estilo para ítems que matchean mientras se tipea el filtro: pinta los
+// runes matcheados con FilteredMatch (que upstream define pero nunca usa),
+// igual que el delegate default de bubbletea
+func (d itemDelegate) itemMatchedStyle(i item, matchedRunes []int) string {
+	unmatched := style.Foreground(lipgloss.Color(d.theme.NormalTitle)).Inline(true)
+	matched := unmatched.
+		Foreground(lipgloss.Color(d.theme.FilteredMatch)).
+		Underline(true)
+
+	matchedTitle := style.
+		PaddingLeft(2).
+		Render(lipgloss.StyleRunes(i.titleBase, matchedRunes, matched, unmatched))
+
+	if !config.ClipseConfig.EnableDescription {
+		if i.pinned {
+			matchedTitle += styledPin(d.theme)
+		}
+		return matchedTitle
+	}
+
+	matchedDesc := style.
+		Foreground(lipgloss.Color(d.theme.NormalDesc)).
+		PaddingLeft(2).
+		Render(i.descriptionBase)
+
+	if i.pinned {
+		matchedDesc += styledPin(d.theme)
+	}
+
+	return fmt.Sprintf("%s\n%s", matchedTitle, matchedDesc)
+}
