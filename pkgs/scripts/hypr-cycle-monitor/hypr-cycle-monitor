# Cicla el foco (o mueve la ventana activa, con --move) entre monitores en
# orden espacial de lectura (y, después x: fila por fila, de izquierda a
# derecha), en vez del orden de creación que usa focusmonitor +1/-1.
#
# Así `prev` (h) va hacia la izquierda y, al agotar la fila, salta al final
# de la fila de arriba; `next` (l) es el inverso exacto. Con solo dos teclas
# el recorrido es un anillo, no navegación 2D: j/k ya las usan las ventanas.
#
# p. ej. eDP (0,0) -> HDMI (1920,0) -> DP-2 (0,1080).

move=0
if [ "${1:-}" = "--move" ]; then
	move=1
	shift
fi

dir=${1:?uso: hypr-cycle-monitor [--move] next|prev}

# un solo snapshot para nombres y foco, para que no se corran entre sí
json=$(hyprctl monitors -j)
mapfile -t mons < <(jq -r 'sort_by(.y, .x) | .[].name' <<<"$json")
focused=$(jq -r 'sort_by(.y, .x) | map(.focused) | index(true)' <<<"$json")

n=${#mons[@]}
if [ "$focused" = "null" ] || [ "$n" -lt 2 ]; then
	exit 0
fi

case $dir in
	next) target=$(( (focused + 1) % n )) ;;
	prev) target=$(( (focused - 1 + n) % n )) ;;
	*)
		echo "uso: hypr-cycle-monitor [--move] next|prev" >&2
		exit 1
		;;
esac

if [ "$move" -eq 1 ]; then
	hyprctl dispatch movewindow "mon:${mons[$target]}"
else
	hyprctl dispatch focusmonitor "${mons[$target]}"
fi
